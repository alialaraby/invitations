<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/styles/hiring-form.css" type="text/css">
    <style>
        .note
        {
            text-align: center;
            height: 90px;
            /*
            background: -webkit-linear-gradient(left, #0072ff, #8811c5);
            */

            background: #8DC63F;
            color: #fff;
            font-weight: bold;
            line-height: 80px;
        }
        .form-content
        {
            padding: 2% 5%;
            border: 1px solid #ced4da;
            margin-bottom: 2%;
            background: #ffffff;
        }

        .btn-primary {
    float: right;
    width: 120px;
    font-weight: bold;
  }
  .form-label {
    margin-bottom: 0.5rem;
    font-weight: bold;
    color: #414042;
}

.alert-warning {
    color: #ff002c !important;

}
.form-control{
    text-align: end !important;
}
.btn-primary{
    background-color: #8DC63F;
    border-color: #8DC63F;
}
.btn-primary:active{
    background-color: #8DC63F;
    border-color: #8DC63F;
}
.btn-primary:focus{
    background-color: #8DC63F;
    border-color: #8DC63F;
}
    </style>
</head>
<body style="background: #8DC63F;">
    <div class="container register-form">
        <div class="form">
          <div>
            <img style="    width: 100%; margin-bottom: 20px;" src="https://api.events.shiragroup.com/form-header.jpg"> </img>
          </div>
            <!-- <div class="note">
                <p>Fill in the following fields.</p>
            </div> -->

            <div class="form-content">
                <div class="row">

                    <% if((typeof alert != 'undefined') && alert.length > 0) { %>
                        <% alert.forEach(function(error) { %>
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                <%= error.msg %>
                              </div>
                        <% }) %>
                    <% } %>

                    <form class="w-100" action="/submit" method="POST">
                        
                        <div class="form-group mb-3">
                            <label for="fullName" class="form-label text-capitalize">full name<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.fullName != 'undefined'){ %>
                                <input type="text" value="<%= reqBody.fullName %>" class="form-control" name="fullName" id="fullName" placeholder="الإسم بالكامل">
                              <% } else{ %>  
                                <input type="text" class="form-control" name="fullName" id="fullName" placeholder="الإسم بالكامل">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="phone" class="form-label text-capitalize">phone<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.phone != 'undefined'){ %>
                                <input type="tel" value="<%= reqBody.phone %>" class="form-control" name="phone" id="phone" placeholder="رقم الهاتف">
                              <% } else{ %>  
                                <input type="tel" class="form-control" name="phone" id="phone" placeholder="رقم الهاتف">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="email" class="form-label text-capitalize">email<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.email != 'undefined'){ %>
                                <input type="email" value="<%= reqBody.email %>" class="form-control" name="email" id="email" placeholder="البريد الإلكترونى">
                              <% } else{ %>  
                                <input type="email" class="form-control" name="email" id="email" placeholder="البريد الإلكترونى">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="company" class="form-label text-capitalize">company<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.company != 'undefined'){ %>
                                <input type="text" value="<%= reqBody.company %>" class="form-control" name="company" id="company" placeholder="الشركة">
                              <% } else{ %>  
                                <input type="text" class="form-control" name="company" id="company" placeholder="الشركة">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="sector" class="form-label">Business Category <span class="text-danger font-weight-bold">*</span></label>
                            <select class="form-select form-control" aria-label="Default select example" name="sector" id="sector">
                                <option selected value="">Business Category</option>
                                <option value="Architect">Architect</option>
                                <option value="Consultant">Consultant</option>
                                <option value="Developer">Developer</option>
                                <option value="General Contractor">General Contractor</option>
                                <option value="Infrastructure Contractor">Infrastructure Contractor</option>
                                <option value="Interiors">Interiors</option>
                                <option value="Landscape Contractor">Landscape Contractor</option>
                                <option value="Traders">Traders</option>
                                <option value="Others">Others</option>
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label for="title" class="form-label text-capitalize">title<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.title != 'undefined'){ %>
                                <input type="text" value="<%= reqBody.title %>" class="form-control" name="title" id="title" placeholder="الوظيفة">
                              <% } else{ %>  
                                <input type="text" class="form-control" name="title" id="title" placeholder="الوظيفة">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <input type="hidden" value="<%= vertX %>" class="form-control" name="vertX" id="vertX">
                        </div>
            
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>
