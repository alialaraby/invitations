<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/styles/hiring-form.css" type="text/css">
</head>
<body>
    <div class="container register-form">
        <div class="form">
            <div class="note">
                <p class="text-capitalize">fill in the following fields.</p>
            </div>

            <div class="form-content">
                <div class="row">
                    
                    <% if((typeof alert != 'undefined') && alert.length > 0) { %>
                        <% alert.forEach(function(error) { %>
                            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                <%= error.msg %>
                              </div>
                        <% }) %>
                    <% } %>

                    <form class="w-100" action="/submit" method="POST">
                        
                        <div class="form-group mb-3">
                            <label for="fullName" class="form-label text-capitalize">full name<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.fullName != 'undefined'){ %>
                                <input type="text" value="<%= reqBody.fullName %>" class="form-control" name="fullName" id="fullName" placeholder="Full name">
                              <% } else{ %>  
                                <input type="text" class="form-control" name="fullName" id="fullName" placeholder="Full name">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="phone" class="form-label text-capitalize">phone<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.phone != 'undefined'){ %>
                                <input type="tel" value="<%= reqBody.phone %>" class="form-control" name="phone" id="phone" placeholder="Phone">
                              <% } else{ %>  
                                <input type="tel" class="form-control" name="phone" id="phone" placeholder="Phone">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="email" class="form-label text-capitalize">email<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.email != 'undefined'){ %>
                                <input type="email" value="<%= reqBody.email %>" class="form-control" name="email" id="email" placeholder="Email">
                              <% } else{ %>  
                                <input type="email" class="form-control" name="email" id="email" placeholder="Email">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="company" class="form-label text-capitalize">company<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.company != 'undefined'){ %>
                                <input type="text" value="<%= reqBody.company %>" class="form-control" name="company" id="company" placeholder="Company">
                              <% } else{ %>  
                                <input type="text" class="form-control" name="company" id="company" placeholder="Company">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="sector" class="form-label text-capitalize">sector<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.sector != 'undefined'){ %>
                                <input type="text" value="<%= reqBody.sector %>" class="form-control" name="sector" id="sector" placeholder="Sector">
                              <% } else{ %>  
                                <input type="text" class="form-control" name="sector" id="sector" placeholder="Sector">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <label for="title" class="form-label text-capitalize">title<span class="text-danger font-weight-bold">*</span></label>
                            <% if(typeof reqBody != 'undefined' && typeof reqBody.title != 'undefined'){ %>
                                <input type="text" value="<%= reqBody.title %>" class="form-control" name="title" id="title" placeholder="Title">
                              <% } else{ %>  
                                <input type="text" class="form-control" name="title" id="title" placeholder="Title">
                            <% } %>
                        </div>

                        <div class="form-group mb-3">
                            <input type="hidden" value="<%= vertX %>" class="form-control" name="vertX" id="vertX">
                        </div>
            
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>